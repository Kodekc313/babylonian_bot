# --- Виртуальные окружения ---
# Игнорируем стандартные папки виртуальных окружений Python
venv/
.venv/
env/

# --- Файл с секретами ---
# КРАЙНЕ ВАЖНО: Никогда не добавляйте этот файл в Git!
.env

# --- Кэш и байт-код Python ---
# Стандартные папки кэша Python
__pycache__/
# Скомпилированные файлы Python
*.py[cod]
*$py.class

# --- Файлы IDE ---
# Игнорируем настройки специфичные для IDE (опционально, но рекомендуется)
.idea/           # Для PyCharm/IntelliJ
.vscode/         # Для Visual Studio Code
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Логи и временные файлы ---
# Игнорируем файлы логов и другие временные файлы
*.log
*.tmp
*.bak
*.swp

# --- Файлы ОС ---
# Игнорируем специфичные для ОС файлы (опционально)
.DS_Store       # macOS
Thumbs.db       # Windows
ehthumbs.db     # Windows
desktop.ini     # Windows

# --- Другое (если появится) ---
# Сюда можно добавлять другие файлы/папки, которые не нужно отслеживать